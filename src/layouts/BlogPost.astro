---
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags?: string[];
}

const { title, description, date, updated, tags = [] } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — Laila Kassar`} description={description}>
  <article class="post">
    <header class="post-header">
      <Eyebrow tone="ink-faint">{fmt(date)}</Eyebrow>
      <h1 class="post-title">{title}</h1>
      <p class="post-description"><em>{description}</em></p>
      {tags.length > 0 && (
        <ul class="post-tags" aria-label="Tags">
          {tags.map((t) => (
            <li><Tag tone="ink" size="sm">{t}</Tag></li>
          ))}
        </ul>
      )}
    </header>

    <div class="post-body">
      <slot />
    </div>

    {updated && (
      <footer class="post-foot">
        <Eyebrow tone="ink-faint">Updated · {fmt(updated)}</Eyebrow>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    max-width: var(--width-prose);
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-10);
  }

  .post-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--lh-tight);
    margin: 0;
  }

  .post-description {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    color: var(--ink-soft);
    line-height: var(--lh-snug);
  }

  .post-description em {
    font-style: italic;
    font-weight: 300;
  }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin-top: var(--space-2);
  }

  .post-foot {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: var(--border-hairline);
  }

  /* --- Markdown content styling --------------------------------- */

  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) {
    font-family: var(--font-serif);
    color: var(--ink);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  .post-body :global(h2) {
    font-size: 1.875rem;
    font-weight: 600;
  }

  .post-body :global(h3) {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .post-body :global(h4) {
    font-size: 1.25rem;
    font-weight: 500;
    font-style: italic;
    color: var(--ink-mid);
  }

  .post-body :global(p) {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--ink-mid);
    margin-bottom: var(--space-5);
  }

  .post-body :global(em),
  .post-body :global(i) {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--ink);
  }

  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .post-body :global(a) {
    color: var(--rose);
    border-bottom: 1px solid var(--rose-mid);
    transition: color var(--duration-fast) var(--ease),
                border-color var(--duration-fast) var(--ease);
  }

  .post-body :global(a:hover) {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-5) var(--space-5);
    padding: 0;
  }

  .post-body :global(li) {
    font-family: var(--font-sans);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--ink-mid);
    margin-bottom: var(--space-2);
  }

  .post-body :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-5);
    border-left: 2px solid var(--rose-mid);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: var(--lh-normal);
    color: var(--ink-mid);
  }

  .post-body :global(hr) {
    border: 0;
    border-top: var(--border-hairline);
    margin: var(--space-8) 0;
  }

  .post-body :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
    color: var(--ink);
  }

  .post-body :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    line-height: var(--lh-relaxed);
    font-size: 0.875rem;
    margin: var(--space-5) 0;
  }

  .post-body :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: inherit;
    color: var(--ink-mid);
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    margin: var(--space-5) 0;
  }

  .post-body :global(th),
  .post-body :global(td) {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-hairline);
  }

  .post-body :global(th) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-soft);
    font-weight: 500;
  }
</style>
